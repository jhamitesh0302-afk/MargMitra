generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ENTREPRENEUR
  TRANSPORTER
  ADMIN
}

enum VehicleType {
  TRACTOR_TROLLEY
  PICKUP
  MINI_TRUCK
  TEMPO
  THREE_WHEELER
  OTHER
}

enum CargoType {
  PERISHABLE_PRODUCE
  GRAIN_PULSES
  DAIRY_POULTRY
  HANDICRAFTS
  GENERAL_GOODS
}

enum TripStatus {
  PLANNED
  ON_THE_WAY
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  MATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  PICKED_UP
  DELIVERED
  CANCELLED
}

model User {
  id           String            @id @default(uuid())
  name         String
  phone        String            @unique
  email        String?           @unique
  password     String
  role         Role              @default(ENTREPRENEUR)
  village      String?
  district     String?
  state        String?
  rating       Float             @default(5.0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  vehicles     Vehicle[]
  trips        Trip[]
  shipments    ShipmentRequest[]
  bookings     Booking[]
}

model Vehicle {
  id              String      @id @default(uuid())
  ownerId         String
  owner           User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vehicleType     VehicleType @default(PICKUP)
  registrationNo  String
  model           String?
  maxCapacityKg   Float
  isAvailable     Boolean     @default(true)
  createdAt       DateTime    @default(now())

  trips           Trip[]
}

model Trip {
  id                  String      @id @default(uuid())
  transporterId       String
  transporter         User        @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  vehicleId           String
  vehicle             Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  originName          String
  originLat           Float
  originLng           Float
  destinationName     String
  destinationLat      Float
  destinationLng      Float
  departureTime       DateTime
  estimatedArrivalTime DateTime?
  totalCapacityKg     Float
  availableCapacityKg Float
  ratePerKgKm         Float       @default(0.05)
  flatRate            Float?
  notes               String?
  status              TripStatus  @default(PLANNED)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  bookings            Booking[]
}

model ShipmentRequest {
  id                  String         @id @default(uuid())
  entrepreneurId      String
  entrepreneur        User           @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)
  title               String
  cargoType           CargoType      @default(GENERAL_GOODS)
  weightKg            Float
  volumeCft           Float?
  pickupLocation      String
  pickupLat           Float
  pickupLng           Float
  dropoffLocation     String
  dropoffLat          Float
  dropoffLng          Float
  pickupDate          DateTime
  maxBudget           Float?
  specialInstructions String?
  status              ShipmentStatus @default(PENDING)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  bookings            Booking[]
}

model Booking {
  id             String        @id @default(uuid())
  tripId         String
  trip           Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  shipmentId     String
  shipment       ShipmentRequest @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  bookedWeightKg Float
  agreedPrice    Float
  pickupOtp      String?
  deliveryOtp    String?
  status         BookingStatus @default(REQUESTED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
