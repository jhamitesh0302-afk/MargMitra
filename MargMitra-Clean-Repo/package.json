{
  "name": "margmitra",
  "version": "1.0.0",
  "description": "Shared transportation and delivery coordination platform for rural entrepreneurs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server"
  },
  "keywords": [
    "rural-logistics",
    "cargo-pooling",
    "route-coordination",
    "shared-transportation",
    "farmers",
    "entrepreneurs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
